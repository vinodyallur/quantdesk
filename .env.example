# Copy to .env and fill in. Never commit .env.
#
# The desk runs with NO keys at all on crypto (Alpaca serves crypto bars
# unauthenticated). Add paper keys to enable order placement and US equities.
#
# Get free paper-only keys at https://alpaca.markets - a "Paper Only Account"
# needs just an email address and is available globally.

QD_ALPACA_API_KEY=
QD_ALPACA_SECRET_KEY=

# --- universe / data -------------------------------------------------------
# crypto trades 24/7 and needs no keys, so it is the default.
QD_ASSET_CLASS=crypto
QD_UNIVERSE=BTC/USD,ETH/USD,LTC/USD,BCH/USD
QD_TIMEFRAME=5Min

# For US equities instead (needs paper keys):
# QD_ASSET_CLASS=us_equity
# QD_UNIVERSE=AAPL,MSFT,NVDA,AMZN,SPY,TSLA
# QD_STOCK_FEED=iex

# --- capital & risk --------------------------------------------------------
QD_STARTING_EQUITY=100000
QD_MAX_POSITION_WEIGHT=0.20
QD_MAX_GROSS_EXPOSURE=1.00
QD_MAX_NET_EXPOSURE=0.60
QD_DAILY_LOSS_LIMIT_PCT=0.03
QD_MAX_DRAWDOWN_PCT=0.15

# --- costs (used by the backtest fill simulator) ---------------------------
QD_COMMISSION_BPS=1.0
QD_SLIPPAGE_BPS=2.0

# --- optional LLM research agent (slow loop, never in the hot path) --------
QD_ENABLE_LLM_AGENT=false
QD_OPENAI_API_KEY=
QD_LLM_MODEL=gpt-4o-mini

QD_LOG_LEVEL=INFO
