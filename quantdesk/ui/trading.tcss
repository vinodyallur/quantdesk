/* Paper trading terminal. Same palette as the rest of the desk. */

Screen { background: #05070a; color: #c8d4e0; }
Header { background: #10161f; color: #ffb000; text-style: bold; }
Footer { background: #10161f; color: #8899aa; }

#setup {
    height: 3;
    padding: 0 1;
    background: #0b1017;
    border-bottom: solid #1d2733;
}

.lbl { color: #667788; padding: 1 1 0 1; width: auto; }
.tiny { width: 16; }
.pick { width: 26; }

Input { background: #10161f; color: #c8d4e0; border: solid #1d2733; }
Input:focus { border: solid #ffb000; }

Button {
    background: #14532d;
    color: #a7f3c0;
    text-style: bold;
    border: none;
    margin: 0 1;
}
Button:hover { background: #1d7a42; }
Button:disabled { background: #1d2733; color: #667788; }

#body { height: 1fr; }
#left { width: 3fr; border-right: solid #1d2733; }
#right { width: 1fr; padding: 0 1; }

.title {
    background: #131b26;
    color: #ffb000;
    text-style: bold;
    padding: 0 1;
    height: 1;
    border-bottom: solid #1d2733;
}

.chart { height: auto; padding: 0 1; background: #05070a; }
#chart { height: 1fr; min-height: 12; }
#equity-chart { height: 9; }
#blotter { height: 16; padding: 0 1; background: #080b11; }

.pane { height: auto; padding: 1; background: #080b11; }
#account { height: auto; }
#funding { height: auto; }

DataTable { background: #05070a; color: #c8d4e0; height: auto; max-height: 8; }
DataTable > .datatable--header { background: #131b26; color: #7f8ea0; text-style: bold; }
DataTable > .datatable--odd-row { background: #080b11; }
