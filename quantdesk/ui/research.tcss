/* Research terminal. Same amber-on-black as the live terminal, because learning a
   second visual language for the same numbers is friction with no payoff. */

Screen {
    background: #05070a;
    color: #c8d4e0;
}

Header {
    background: #10161f;
    color: #ffb000;
    text-style: bold;
}

Footer {
    background: #10161f;
    color: #8899aa;
}

Tabs {
    background: #10161f;
}

TabbedContent {
    height: 1fr;
}

.controls {
    height: 3;
    padding: 0 1;
    background: #0b1017;
    border-bottom: solid #1d2733;
}

.lbl {
    color: #667788;
    padding: 1 1 0 1;
    width: auto;
}

.tiny {
    width: 18;
}

.pick {
    width: 30;
}

Input {
    background: #10161f;
    color: #c8d4e0;
    border: solid #1d2733;
}

Input:focus {
    border: solid #ffb000;
}

Select {
    background: #10161f;
}

Button {
    background: #1d2733;
    color: #ffb000;
    text-style: bold;
    border: none;
    margin: 0 1;
}

Button:hover {
    background: #2a3746;
}

.report {
    height: auto;
    padding: 1 2;
    background: #080b11;
}

.title {
    background: #131b26;
    color: #ffb000;
    text-style: bold;
    padding: 0 1;
    height: 1;
    border-bottom: solid #1d2733;
}

DataTable {
    background: #05070a;
    color: #c8d4e0;
    height: auto;
    max-height: 28;
}

DataTable > .datatable--header {
    background: #131b26;
    color: #7f8ea0;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1d2733;
}

DataTable > .datatable--odd-row {
    background: #080b11;
}
