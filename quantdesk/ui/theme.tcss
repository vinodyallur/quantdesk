/* Terminal styling: amber on black, the way a trading terminal reads at 3am.
   High contrast and no decoration, because the only thing worth looking at is
   the numbers. */

Screen {
    background: #05070a;
    color: #c8d4e0;
}

Header {
    background: #10161f;
    color: #ffb000;
    text-style: bold;
}

Footer {
    background: #10161f;
    color: #8899aa;
}

#body {
    height: 1fr;
}

#left {
    width: 2fr;
    border-right: solid #1d2733;
}

#right {
    width: 1fr;
    padding: 0 1;
}

.title {
    background: #131b26;
    color: #ffb000;
    text-style: bold;
    padding: 0 1;
    height: 1;
    border-bottom: solid #1d2733;
}

DataTable {
    background: #05070a;
    color: #c8d4e0;
    height: auto;
    max-height: 14;
}

DataTable > .datatable--header {
    background: #131b26;
    color: #7f8ea0;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1d2733;
}

DataTable > .datatable--odd-row {
    background: #080b11;
}

#market {
    max-height: 10;
}

#positions {
    max-height: 8;
}

#signals {
    max-height: 12;
}

#decisions {
    height: 1fr;
    min-height: 6;
    background: #05070a;
    border-top: solid #1d2733;
}

#risk {
    height: auto;
    padding: 1;
    background: #080b11;
}

#checklist {
    height: auto;
    padding: 1;
}

/* The kill switch should look like what it is. */
Footer > .footer--key {
    background: #10161f;
    color: #ffb000;
}
